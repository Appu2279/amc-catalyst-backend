# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
# Set to "production" when deployed. Also stops the schema auto-sync on boot.
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# Production: one connection string from your host (Supabase/Neon/Railway).
# When set, it takes precedence and TLS is enabled automatically.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Local development: individual values.
DB_NAME=amc_catalyst
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate a fresh one per environment: openssl rand -hex 32
JWT_SECRET=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated. Leave unset locally to allow all origins.
# CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# ── Admin account ────────────────────────────────────────────────────────────
# Used by `npm run admin:reset` and the admin seeder. Never commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── S3 storage ───────────────────────────────────────────────────────────────
# Required for study notes and payment screenshots: `npm run notes:upload`
# writes PDFs here, and GET /api/notes/:id/file streams them back server-side.
# Without these the notes list still loads but opening a note returns 503.
#
# Locally, AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY come from an IAM user
# scoped to this bucket. In production, leave them unset — the EC2 instance's
# IAM role supplies credentials automatically and none should ever sit in a
# production .env.
AWS_REGION=ap-south-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
